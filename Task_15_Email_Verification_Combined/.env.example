PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_BACKEND_SECRET_KEY

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=2h
COOKIE_NAME=task15_access
COOKIE_SECURE=false

# EMAIL MODE
# console = easiest local testing; verification code is printed in backend terminal.
# smtp = real email delivery using the SMTP settings below.
EMAIL_MODE=console

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="VerifyFlow <your_email@gmail.com>"

VERIFICATION_CODE_MINUTES=15
RESEND_COOLDOWN_SECONDS=60
MAX_VERIFY_ATTEMPTS=5

VITE_API_URL=http://localhost:5000/api/v1
